# Database Configuration
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://uabams_user:replace_with_strong_db_password@postgres:5432/uabams_db
POSTGRES_DB=uabams_db
POSTGRES_USER=uabams_user
POSTGRES_PASSWORD=replace_with_strong_db_password

# Authentication & Security
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ADMIN_RESET_KEY=replace-with-generated-admin-reset-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-admin-password
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=replace-with-strong-operator-password

# Static Gateway API Keys (Optional legacy fallback)
GATEWAY_API_KEY_GW01=replace-with-generated-gw1-key
GATEWAY_API_KEY_GW02=replace-with-generated-gw2-key

# Server & Public Network Settings
CLOUD_PUBLIC_BASE_URL=http://20.8.1.15:8000

# SFTP / Gateway SSH Upload Settings
SSH_HOST=20.8.1.15
SSH_PORT=2222
SSH_USER=uabams_upload
SSH_HOST_KEY="[20.8.1.15]:2222 ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIFQFEVhatPXMJx7b0Z0uoRqZIkS8qEDLFb8WoeI0eksr"
AUTHORIZED_KEYS_PATH=/app/sftp_keys/authorized_keys
UPLOAD_BASE_DIR=/app/incoming

# Qikberry SMS Gateway
QIKBERRY_AUTH_TOKEN=your_qikberry_api_token_here
SMS_SENDER=IRAPNA
SMS_SERVICE=SI
SMS_TEMPLATE_ID=1077127650088578029

# MSG91 SMS Gateway
